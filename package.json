{
  "name": "pi-jev",
  "version": "0.3.2",
  "description": "A Pi extension for Jev-guided context selection",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "context-management",
    "jev"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit && vitest run --dir test",
    "dev": "pi -e ./src/extension.ts",
    "test": "vitest run --dir test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "typebox": "1.3.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "22.19.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
