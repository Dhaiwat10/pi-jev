{
  "name": "pi-jev",
  "version": "0.1.0",
  "description": "A Pi coding harness with Jev-guided context selection",
  "type": "module",
  "bin": {
    "pi-jev": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit && vitest run test",
    "dev": "tsx src/cli.ts",
    "test": "vitest run test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@typesafe-ai/sdk": "0.6.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
